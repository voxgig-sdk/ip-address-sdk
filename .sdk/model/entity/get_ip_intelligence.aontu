# Entity: get_ip_intelligence

main: kit: entity: get_ip_intelligence: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    ip: {
      h: "Ip"
      n: "ip"
      r: false
      sh: "The queried IP address"
      t: "`$STRING`"
    }
    isp: {
      h: "Isp"
      n: "isp"
      r: false
      sh: "Internet Service Provider name"
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "Location information for the IP address"
      t: "`$OBJECT`"
    }
    risk: {
      h: "Risk"
      n: "risk"
      r: false
      sh: "Risk assessment data for the IP address"
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "get_ip_intelligence"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /{ip}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "1.1.1.1"
                k: "param"
                n: "id"
                or: "ip"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "json"
                k: "query"
                n: "format"
                or: "format"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/{ip}"
          q: {
            exist: [
              "format"
              "id"
            ]
          }
          r: {
            param: {
              ip: "id"
            }
          }
          s: [
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
